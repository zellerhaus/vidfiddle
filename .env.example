# Copy to .env and fill in. With docker compose, DATABASE_URL and DATA_DIR are set for you.

# --- Required ---------------------------------------------------------------
# Password for the single login.
APP_PASSWORD=
# Protects the /api/cron routes the worker calls. Any long random string.
CRON_SECRET=
# The app's public base URL. Publer and Instagram fetch videos from here, so it must be reachable
# from the internet if you schedule posts (or use S3 storage below).
PUBLIC_URL=http://localhost:3000
# Host port docker compose publishes the app on.
# APP_PORT=3000

# --- AI ---------------------------------------------------------------------
# One OpenAI key runs everything: scripts, captions, and the local video engine.
OPENAI_API_KEY=
# Or write scripts and captions with Claude instead. Set LLM_PROVIDER to choose when both keys are set.
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai            # openai | anthropic
# OPENAI_TEXT_MODEL=gpt-6.1-terra
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- ElevenLabs (optional) -------------------------------------------------------
# Unlocks ElevenLabs voices for narration (choose "ElevenLabs" on the Style step or in Video
# Defaults) and per-video music below. Billed in ElevenLabs credits, about one per character.
# ELEVENLABS_API_KEY=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Voice used when ElevenLabs is chosen without picking one.
# ELEVENLABS_VOICE_ID=

# --- Music ------------------------------------------------------------------
# Local-engine videos get a music bed picked by mood from assets/music (starter tracks) and
# MUSIC_DIR (your own; docker compose mounts ./music). See music/README.md.
# MUSIC_DIR=./data/music
# With ELEVENLABS_API_KEY set, ElevenLabs Music composes a fresh instrumental for every video
# instead; the library is the fallback if a request fails. MUSIC_PROVIDER=library keeps the
# library even with a key (for ElevenLabs voices without ElevenLabs music).
# ELEVENLABS_MUSIC_MODEL=music_v2_5
# MUSIC_PROVIDER=library

# --- Storage ----------------------------------------------------------------
# local (default): files live in DATA_DIR/media and are served at PUBLIC_URL/media/...
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# STORAGE_DRIVER=local
# DATA_DIR=./data
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.example.com

# --- Optional services --------------------------------------------------------
# Creatify: hosted AI video generation (stock footage, avatars). Not needed for the local engine.
CREATIFY_API_ID=
CREATIFY_API_KEY=
# Publer: schedules posts to Instagram, TikTok, YouTube, LinkedIn, X and Facebook.
PUBLER_API_KEY=
PUBLER_WORKSPACE_ID=
PUBLER_WEBHOOK_SECRET=
# Postiz: open-source scheduler (postiz.com), self-hosted or Postiz Cloud. Create the API key in
# Postiz settings. For a self-hosted install, POSTIZ_URL is its backend URL (with the official
# compose file, https://your-postiz/api); leave it unset for Postiz Cloud. Vidfiddle uploads each
# video to Postiz as a file, so Postiz doesn't need to reach PUBLIC_URL.
# POSTIZ_API_KEY=
# POSTIZ_URL=https://postiz.example.com/api
# TryPost: open-source scheduler (trypost.it), self-hosted or TryPost Cloud. Create a workspace API
# key as a workspace admin. For a self-hosted install, TRYPOST_URL is its APP_URL; leave it unset
# for TryPost Cloud. TryPost downloads videos from PUBLIC_URL, which must be public.
# TRYPOST_API_KEY=
# TRYPOST_URL=https://trypost.example.com
# LightPost (experimental): self-hosted scheduler (github.com/brainstormity/LightPost). Released
# LightPost can't post these videos yet, so publish with Publer, Postiz or TryPost. It imports
# videos from PUBLIC_URL, which must be reachable over HTTPS. If LightPost has no password set, it
# only accepts requests addressed to localhost.
# LIGHTPOST_URL=https://lightpost.example.com
# LIGHTPOST_PASSWORD=
# LIGHTPOST_ACCOUNTS=instagram=<accountId>,linkedin=<accountId>   # default: every connected account
# Which publisher to use when several are configured: publer | postiz | trypost | lightpost.
# Default: the first configured, in that order.
# PUBLISHER=postiz

# --- Worker -------------------------------------------------------------------
# Cron schedules (5-field, server local time). Override any job, or set it to "off".
# CRON_CHECK_FEEDS="0 8 * * *"
# CRON_PROCESS_QUEUE="0 9 * * *"
# CRON_CHECK_CREATIFY="*/2 * * * *"
# CRON_VERIFY_PUBLER="*/10 * * * *"
# CRON_LOG_RETENTION_DAYS=14

# --- Running without Docker ---------------------------------------------------
# DATABASE_URL=postgres://user:password@localhost:5432/vidfiddle
# WORKER_PORT=3001                      # the worker's health check (GET /health)
# APP_INTERNAL_URL=http://localhost:3000 # where the worker reaches the app
# FFMPEG_PATH=ffmpeg                     # must be built with libass for captions
# FFPROBE_PATH=ffprobe
# APP_SECRET=                            # session signing key; defaults to one derived from APP_PASSWORD
